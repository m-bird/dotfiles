export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# fpath を毎回組み直す: 継承した FPATH をそのまま使うと、tmux 経由で古い環境
# (brew upgrade zsh 前に export された値) を引き継いだ pane が、存在しない
# Cellar バージョンディレクトリを参照して compinit/add-zsh-hook/compdef が
# "function definition file not found" で失敗する
typeset -gU fpath
fpath=(
  /usr/local/share/zsh/site-functions
  "${HOMEBREW_PREFIX}/share/zsh/site-functions"(N)
  "${HOMEBREW_CELLAR}"/zsh/*/share/zsh/functions(N)
)

typeset -gU path PATH
path=(
  "$HOME/.local/bin"(N-/)
  "$HOME/bin"(N-/)
  $path
)

# Laod system wide scripts : /etc/profile.d
# This can set the system default environment variables.
if [ -d /etc/profile.d ]; then
  for i in /etc/profile.d/*.sh ; do
    [ -r $i ] && source $i
  done
fi

_host_name="${HOST%%.*}"
if [[ -n "$_host_name" ]]; then
  _host_env="${ZDOTDIR}/host/${_host_name}.zshenv"
  [[ -r "$_host_env" ]] && source "$_host_env"
fi
unset _host_name _host_env
